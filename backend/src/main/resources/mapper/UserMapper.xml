<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wepay.promotion.mapper.UserMapper">

    <!--
      分片规则: t_user -> ds${0..3}.t_user_${0..3}
      分片键: user_id, 算法: HASH_MOD(4)

      ShardingSphere 5.x standard 策略的路由行为:
      - INSERT/UPDATE/DELETE/SELECT WHERE 带 user_id: 按 user_id % 4 精准路由到 1 库 1 表
        ShardingSphere 会自动为逻辑表 t_user 添加库/表后缀:
          库路由:  ds{N},   N = user_id.hashCode() % 4
          表路由:  t_user_{M}, M = user_id.hashCode() % 4
      - SELECT WHERE 仅带 openid (无分片键 user_id): 自动广播到 4 库 × 4 表 = 16 物理表
        ShardingSphere 会为每个物理分片生成重写后的 SQL:
          FROM ds0.t_user_0 / ds0.t_user_1 / ... / ds3.t_user_3, 合并结果返回

      广播查询性能优化 (Redis 降级):
      - 首次登录: ShardingSphere 自动广播 16 表查 openid, 查回后回写 Redis openid → userId
      - 后续登录: UserService 先查 Redis, 命中后直接走 selectByUserId 精准路由
    -->

    <!--
      广播查询: openid 查用户 (无分片键, ShardingSphere 自动路由到 ds0..3.t_user_0..3)
      ShardingSphere 会将逻辑表 t_user 重写为所有物理分片表名(自动添加后缀 _0.._3)
    -->
    <select id="selectByOpenid" resultType="com.wepay.promotion.entity.User">
        SELECT id, user_id, openid, union_id, create_time, update_time
        FROM t_user_0 WHERE openid = #{openid}
    </select>

    <!--
      精准路由: 带分片键 user_id, ShardingSphere 按 HASH_MOD(4) 计算后缀
      逻辑表 t_user → 重写为 ds{N}.t_user_{M} 单个物理表
    -->
    <select id="selectByUserId" resultType="com.wepay.promotion.entity.User">
        SELECT id, user_id, openid, union_id, create_time, update_time
        FROM t_user WHERE user_id = #{userId}
    </select>

    <!--
      精准路由: INSERT 带 user_id (分片键), ShardingSphere 自动添加库/表后缀
      逻辑表 t_user → 重写为 ds{N}.t_user_{M} 单个物理表
    -->
    <insert id="insert" parameterType="com.wepay.promotion.entity.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_user (user_id, openid, union_id)
        VALUES (#{userId}, #{openid}, #{unionId})
    </insert>
</mapper>
