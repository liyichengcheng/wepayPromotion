<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wepay.promotion.mapper.UserMapper">

    <!--
      分片规则: t_user -> ds${0..3}.t_user_${0..3}
      分片键: openid, 算法: HASH_MOD(4)

      ShardingSphere 5.x standard 策略的路由行为:
      - INSERT/UPDATE/DELETE/SELECT WHERE 带 openid: 按 openid % 4 精准路由到 1 库 1 表
        ShardingSphere 会自动为逻辑表 t_user 添加库/表后缀:
          库路由:  ds{N},   N = openid.hashCode() % 4
          表路由:  t_user_{M}, M = openid.hashCode() % 4
    -->

    <!--
      精准路由: 带分片键 openid, ShardingSphere 按 HASH_MOD(4) 计算后缀
      逻辑表 t_user → 重写为 ds{N}.t_user_{M} 单个物理表
    -->
    <select id="selectByOpenid" resultType="com.wepay.promotion.entity.User">
        SELECT id, openid, union_id, create_time, update_time
        FROM t_user WHERE openid = #{openid}
    </select>

    <!--
      精准路由: INSERT 带 openid (分片键), ShardingSphere 自动添加库/表后缀
      逻辑表 t_user → 重写为 ds{N}.t_user_{M} 单个物理表
    -->
    <insert id="insert" parameterType="com.wepay.promotion.entity.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_user (openid, union_id)
        VALUES (#{openid}, #{unionId})
    </insert>
</mapper>
