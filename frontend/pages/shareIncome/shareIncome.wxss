.page {
  padding: 0 24rpx 60rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
}

.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.nav-back {
  position: absolute;
  left: 24rpx;
  font-size: 36rpx;
  color: #333;
  padding: 12rpx 20rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.unlock-banner {
  margin-top: 112rpx;
  background: linear-gradient(135deg, #07c160, #0ad870);
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 30rpx rgba(7, 193, 96, 0.25);
}

.unlock-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.unlock-icon text {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: bold;
}

.unlock-text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: bold;
}

.link-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  text-align: center;
}

.card-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.qr-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-placeholder {
  width: 200rpx;
  height: 200rpx;
  background: #f5f5f5;
  border: 2rpx dashed #ddd;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.qr-icon {
  font-size: 80rpx;
}

.qr-tip {
  font-size: 26rpx;
  color: #07c160;
}

.stats-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx 24rpx;
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-label {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 44rpx;
  color: #07c160;
  font-weight: bold;
}

.stat-income {
  font-size: 40rpx;
  color: #07c160;
  font-weight: bold;
  display: inline-block;
}

.stat-unit {
  font-size: 24rpx;
  color: #888;
  margin-left: 4rpx;
}

.stat-sub {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 80rpx;
  background: #eee;
}

.rule-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.rule-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.rule-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 24rpx;
}

.rule-desc text {
  display: block;
}

.rule-example {
  display: flex;
  align-items: flex-start;
  background: #f9f9f9;
  padding: 24rpx;
  border-radius: 16rpx;
}

.rule-badge {
  flex-shrink: 0;
  background: linear-gradient(135deg, #f97316, #fb923c);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.rule-detail {
  flex: 1;
  font-size: 24rpx;
  color: #666;
  line-height: 1.7;
}

.share-action {
  background: linear-gradient(135deg, #07c160, #0ad870);
  color: #ffffff;
  text-align: center;
  padding: 32rpx 0;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 500;
  margin-top: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.35);
  border: none;
  line-height: 1;
}

.share-action::after {
  display: none;
}

.withdraw-btn-group {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
}

.withdraw-btn {
  background: linear-gradient(135deg, #07c160, #0ad870);
  color: #ffffff;
  padding: 10rpx 32rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.terminate-auth-btn {
  color: #999;
  padding: 10rpx 20rpx;
  margin-left: 16rpx;
  font-size: 22rpx;
}

/* 授权引导弹窗 */
.auth-guide-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  background: #ffffff;
  border-radius: 24rpx;
  z-index: 1000;
  overflow: hidden;
}

.auth-guide-header {
  padding: 40rpx 32rpx 24rpx;
  text-align: center;
}

.auth-guide-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.auth-guide-body {
  padding: 16rpx 32rpx 40rpx;
  text-align: center;
}

.auth-guide-icon {
  width: 96rpx;
  height: 96rpx;
  background: rgba(7, 193, 96, 0.08);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.auth-guide-icon text {
  font-size: 48rpx;
}

.auth-guide-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.7;
}

.auth-guide-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.auth-guide-cancel,
.auth-guide-confirm {
  flex: 1;
  padding: 28rpx 0;
  text-align: center;
  font-size: 30rpx;
}

.auth-guide-cancel {
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.auth-guide-confirm {
  color: #07c160;
  font-weight: bold;
}

/* 提现弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

.withdraw-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  background: #ffffff;
  border-radius: 24rpx;
  z-index: 1000;
  overflow: hidden;
}

.withdraw-modal-header {
  padding: 40rpx 32rpx 24rpx;
  text-align: center;
}

.withdraw-modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.withdraw-modal-body {
  padding: 16rpx 32rpx 40rpx;
}

.withdraw-modal-notice {
  padding: 20rpx 24rpx;
  background: rgba(249, 115, 22, 0.08);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #f97316;
  line-height: 1.6;
  margin-bottom: 32rpx;
  text-align: center;
}

.withdraw-input-row {
  display: flex;
  flex-direction: column;
}

.withdraw-input-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.withdraw-input-wrapper {
  display: flex;
  align-items: center;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
  background: #fafafa;
}

.withdraw-input-currency {
  font-size: 36rpx;
  color: #07c160;
  font-weight: bold;
  margin-right: 8rpx;
}

.withdraw-input {
  flex: 1;
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
}

.withdraw-input-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.withdraw-modal-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.withdraw-modal-cancel,
.withdraw-modal-confirm {
  flex: 1;
  padding: 28rpx 0;
  text-align: center;
  font-size: 30rpx;
}

.withdraw-modal-cancel {
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.withdraw-modal-confirm {
  color: #07c160;
  font-weight: bold;
}

.copy-link-btn {
  text-align: center;
  padding: 24rpx 0;
  margin-top: 20rpx;
  margin-left: auto;
  margin-right: auto;
  width: 80%;
  border: 2rpx solid #07c160;
  border-radius: 50rpx;
  color: #07c160;
  font-size: 30rpx;
  font-weight: 500;
  background: #ffffff;
}

.share-tip {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
}
