.page {
  padding: 0 24rpx 40rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
}

.search-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}

.search-input {
  flex: 1;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.search-placeholder {
  color: #999;
  font-size: 28rpx;
}

.search-action {
  margin-left: 24rpx;
  font-size: 40rpx;
}

.section-title {
  margin: 24rpx 0 32rpx;
}

.title-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.title-line {
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #07c160, #0ad870);
  margin-top: 12rpx;
  border-radius: 3rpx;
}

.article-card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.article-cover {
  position: relative;
  width: 100%;
  height: 400rpx;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.article-tags {
  position: absolute;
  bottom: 24rpx;
  left: 24rpx;
  display: flex;
  gap: 16rpx;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
}

.tag-green {
  background: linear-gradient(135deg, #07c160, #0ad870);
}

.tag-blue {
  background: linear-gradient(135deg, #3b82f6, #60a5fa);
}

.tag-orange {
  background: linear-gradient(135deg, #f97316, #fb923c);
}

.article-info {
  padding: 28rpx;
}

.article-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.article-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  flex: 1;
}

.enter-btn {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  margin-left: 16rpx;
}

.article-author {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.article-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.highlight-red {
  color: #e53935;
  font-weight: bold;
}

.lock-tip {
  font-size: 24rpx;
  color: #07c160;
  background: rgba(7, 193, 96, 0.08);
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  display: inline-block;
}

.price-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.price-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.price-amount {
  display: flex;
  align-items: baseline;
}

.currency {
  font-size: 36rpx;
  color: #07c160;
  font-weight: bold;
}

.price-value {
  font-size: 64rpx;
  color: #07c160;
  font-weight: bold;
  margin-left: 4rpx;
}

.paid-label {
  font-size: 36rpx;
  color: #07c160;
  font-weight: bold;
  background: rgba(7, 193, 96, 0.1);
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
}

.unlock-btn {
  background: linear-gradient(135deg, #07c160, #0ad870);
  color: #ffffff;
  padding: 24rpx 56rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
}

.price-rule {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.price-progress {
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.progress-label {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.progress-num {
  color: #07c160;
  font-weight: bold;
  font-size: 30rpx;
  margin-left: 8rpx;
}

.progress-bar {
  position: relative;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: visible;
}

.progress-fill {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  background: linear-gradient(90deg, #07c160, #0ad870);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-thumb {
  position: absolute;
  top: 50%;
  width: 24rpx;
  height: 24rpx;
  background: #ffffff;
  border: 4rpx solid #07c160;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.share-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.share-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.rebate-badge {
  flex-shrink: 0;
  background: linear-gradient(135deg, #f97316, #fb923c);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
}

.share-desc {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.share-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.rebate-amount {
  font-size: 28rpx;
  color: #07c160;
  font-weight: bold;
  margin-top: 12rpx;
}

.share-btn {
  background: linear-gradient(135deg, #07c160, #0ad870);
  color: #ffffff;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 500;
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.35);
}

.evidence-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.evidence-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.evidence-title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.evidence-title-hint {
  font-size: 24rpx;
  color: #999;
  margin-left: 16rpx;
}

.evidence-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.evidence-item {
  width: 48%;
  height: 320rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  background: #f5f5f5;
}

.pay-bottom-bar {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pay-tip {
  flex: 1;
}

.pay-tip-text {
  font-size: 26rpx;
  color: #999;
}

.pay-btn {
  background: linear-gradient(135deg, #07c160, #0ad870);
  color: #ffffff;
  padding: 24rpx 56rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
}

/* 确认支付弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

.pay-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  background: #ffffff;
  border-radius: 24rpx;
  z-index: 1000;
  overflow: hidden;
}

.pay-modal-header {
  padding: 40rpx 32rpx 24rpx;
  text-align: center;
}

.pay-modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.pay-modal-body {
  padding: 16rpx 32rpx 40rpx;
  text-align: center;
}

.pay-info-line {
  margin-bottom: 20rpx;
}

.pay-info-text {
  font-size: 30rpx;
  color: #333;
}

.pay-info-num {
  font-size: 34rpx;
  font-weight: bold;
  color: #07c160;
  margin: 0 4rpx;
}

.pay-info-price {
  font-size: 40rpx;
  font-weight: bold;
  color: #e53935;
  margin-left: 4rpx;
}

.pay-info-sub {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.pay-modal-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.pay-modal-cancel,
.pay-modal-confirm {
  flex: 1;
  padding: 28rpx 0;
  text-align: center;
  font-size: 30rpx;
}

.pay-modal-cancel {
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.pay-modal-confirm {
  color: #07c160;
  font-weight: bold;
}
